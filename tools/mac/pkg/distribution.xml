<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>CheatChord</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline><line choice="default"><line choice="cc"/></line></choices-outline>
    <choice id="default"/>
    <choice id="cc" visible="false"><pkg-ref id="com.jjdaplug.cheatchord"/></choice>
    <pkg-ref id="com.jjdaplug.cheatchord" version="4.1.0" onConclusion="none">CheatChord-core.pkg</pkg-ref>
</installer-gui-script>
